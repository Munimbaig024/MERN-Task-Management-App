# ── Client Environment Variables (Vite) ─────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# NEVER commit the .env file — it is listed in .gitignore.

# Base URL of the backend API
# In development, Vite's proxy handles /api → http://localhost:5000 automatically.
# In production, set this to your deployed backend URL.
VITE_API_BASE_URL=http://localhost:5000/api
